# X06 staging environment. Copy to staging.env and replace every placeholder. No secrets in this file:
# they go in files under CREATOR_SECRETS_DIR (database_url, metrics_token, oidc_client_secret).
CREATOR_DEPLOYMENT_MODE=hosted
CREATOR_ENVIRONMENT=staging
# Set by the release step to the exact commit being deployed (full 40-character SHA).
CREATOR_BUILD_COMMIT=0000000000000000000000000000000000000000
CREATOR_LISTEN_HOST=0.0.0.0
CREATOR_PUBLIC_WEB_ORIGIN=https://studio.staging.example.invalid
CREATOR_WEB_ORIGIN=https://studio.staging.example.invalid
CREATOR_PUBLIC_PREVIEW_ORIGIN=https://previews-staging.example-preview.invalid
CREATOR_WEB_HOST=studio.staging.example.invalid
CREATOR_PREVIEW_HOST=previews-staging.example-preview.invalid
CREATOR_ACME_EMAIL=owner@example.invalid
CREATOR_AUTH_MODE=oidc
CREATOR_OIDC_ISSUER=https://issuer.example.invalid
CREATOR_OIDC_CLIENT_ID=creator-staging
CREATOR_OIDC_REDIRECT_URI=https://studio.staging.example.invalid/api/auth/oidc/callback
CREATOR_OIDC_OWNER_SUBJECT=replace-with-your-subject
# Live adapters stay off unless separately decided and configured.
CREATOR_GITHUB=off
