{
  "name": "creator-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.2 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build:code": "tsc -b",
    "build": "pnpm build:code && pnpm --filter @creator/web build",
    "typecheck": "tsc -b && pnpm --filter @creator/web typecheck",
    "test": "pnpm build:code && node --test --test-concurrency=1 tests/dist/*.test.js && pnpm test:dev-safety",
    "test:dev-safety": "node --test --test-concurrency=1 tests/dev-artifact-retention.test.mjs tests/theme-intent-upgrade-current-guards.test.mjs tests/development-config.test.mjs",
    "test:historical-upgrade": "node --test tests/theme-intent-upgrade-v4-guards.test.mjs",
    "test:db": "node scripts/require-test-db.mjs && pnpm test",
    "format": "prettier --write apps packages tests scripts config docs package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json .prettierrc.json",
    "format:check": "prettier --check apps packages tests scripts config docs package.json pnpm-workspace.yaml tsconfig.json tsconfig.base.json .prettierrc.json",
    "check": "pnpm typecheck && pnpm test && pnpm format:check",
    "dev": "pnpm build:code && node scripts/dev.mjs",
    "dev:api": "pnpm build:code && node apps/api/dist/main.js",
    "worker": "pnpm build:code && node packages/orchestrator/dist/main.js",
    "pilot": "pnpm build:code && node packages/orchestrator/dist/pilot-main.js",
    "evaluate": "pnpm build:code && node packages/orchestrator/dist/evaluate-main.js",
    "analyze": "pnpm build:code && node packages/orchestrator/dist/analyze-main.js",
    "db:migrate": "pnpm build:code && node packages/db/dist/migrate-main.js",
    "backup": "pnpm build:code && node packages/db/dist/backup-main.js",
    "ops": "pnpm build:code && node packages/db/dist/ops-main.js",
    "dev:web": "pnpm --filter @creator/web dev",
    "cli": "node apps/cli/dist/main.js",
    "smoke": "pnpm build && node scripts/smoke.mjs",
    "readiness": "pnpm build:code && node packages/orchestrator/dist/readiness-main.js",
    "bench": "pnpm build:code && node tests/dist/x10-bench-main.js",
    "release-archive": "node scripts/release-archive.mjs"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "axe-core": "4.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
