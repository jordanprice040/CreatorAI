{
  "format": "p15-web-benchmark-spec/1",
  "benchmark_id": "p15-small-signup-v2",
  "scale": "small",
  "title": "P15 small web benchmark: sign-up form v2",
  "content": {
    "audience": "Synthetic benchmark operator measuring the studio's static web build path at small scale",
    "problem_statement": "Measure whether the bounded builder and independent reviewer can deliver a single static page with a sign-up form and client-side validation, against frozen browser cases including held-out edge cases, run by the reviewed headless-browser checker. This is a synthetic benchmark, not a customer product.",
    "user_flows": [
      {
        "key": "F1",
        "name": "Sign up",
        "steps": [
          "Open the page",
          "Enter a name and an email address, choose a plan and accept the terms",
          "Press Create account (or Enter in a text field)",
          "Read the welcome message"
        ]
      },
      {
        "key": "F2",
        "name": "Fix mistakes",
        "steps": [
          "Press Create account with missing or invalid fields",
          "Read one message per problem and the problem count",
          "Correct the fields and submit again"
        ]
      }
    ],
    "scope": [
      "Static files only: site/index.html, site/style.css and site/app.js. Plain HTML, CSS and JavaScript; no packages, CDNs, network requests or browser storage",
      "Page title exactly: Sign up. One form, id signup, holding: input #name labelled Name, input #email labelled Email, select #plan labelled Plan, checkbox #terms labelled exactly I accept the terms, and submit button #submit with text Create account",
      "Select #plan has exactly two options: value free shown as Free (the default) and value pro shown as Pro",
      "Elements #name-error, #email-error, #terms-error, #summary and #done always exist and are hidden (the hidden attribute) until they have something to say. No message is shown before the first submit",
      "Validate only on submit, with browser built-in validation off. Name: the trimmed value has 2 to 40 characters, else #name-error says exactly Enter your name (2 to 40 characters)",
      "Email: the trimmed value is non-space characters except @, one @, non-space characters except @, a dot, then non-space characters except @, else #email-error says exactly Enter a valid email address",
      "Terms: checked, else #terms-error says exactly Accept the terms to continue",
      "On a failed submit show every failing field message at once, hide the messages of fields that now pass, keep the form visible and show #summary with exactly Fix 1 problem or Fix N problems (N the number of failing fields)",
      "On a successful submit hide all messages and #summary, hide the form #signup, and show #done with exactly: Welcome, NAME! You chose the PLAN plan. where NAME is the trimmed name and PLAN is Free or Pro",
      "Pressing Enter in the name or email field submits the form. No uncaught errors and no requests other than the three site files"
    ],
    "non_goals": [
      "Sending data anywhere",
      "Accounts, persistence or storage",
      "Server code",
      "Styling beyond readable defaults",
      "Public release"
    ],
    "data_contracts": [
      {
        "name": "signup-form/1",
        "description": "Synthetic names and email addresses typed into the page; nothing leaves the browser",
        "data_class": "synthetic"
      }
    ],
    "acceptance_checks": [
      {
        "key": "A1",
        "flow": "F1",
        "statement": "A valid sign-up shows the welcome message with the trimmed name and chosen plan and hides the form",
        "measure": "Browser case steps pass in the reviewed checker",
        "method": "browser_check",
        "browser_cases": [
          {
            "page": "/",
            "steps": [
              {
                "action": "fill",
                "selector": "#name",
                "value": "Ada Lovelace"
              },
              {
                "action": "fill",
                "selector": "#email",
                "value": "ada@example.com"
              },
              {
                "action": "check",
                "selector": "#terms"
              },
              {
                "action": "click",
                "selector": "#submit"
              },
              {
                "action": "expect_text",
                "selector": "#done",
                "text": "Welcome, Ada Lovelace! You chose the Free plan."
              },
              {
                "action": "expect_hidden",
                "selector": "#signup"
              },
              {
                "action": "expect_hidden",
                "selector": "#summary"
              }
            ],
            "held_out": false
          },
          {
            "page": "/",
            "steps": [
              {
                "action": "fill",
                "selector": "#name",
                "value": " Grace"
              },
              {
                "action": "select",
