                "value": "pro"
              },
              {
                "action": "fill",
                "selector": "#email",
                "value": "g@x.io"
              },
              {
                "action": "check",
                "selector": "#terms"
              },
              {
                "action": "press",
                "selector": "#email",
                "key": "Enter"
              },
              {
                "action": "expect_text",
                "selector": "#done",
                "text": "Welcome, Grace! You chose the Pro plan."
              },
              {
                "action": "expect_hidden",
                "selector": "#name-error"
              }
            ],
            "held_out": true
          }
        ]
      },
      {
        "key": "A2",
        "flow": "F2",
        "statement": "A failed submit shows one exact message per failing field and the problem count",
        "measure": "Browser case steps pass in the reviewed checker",
        "method": "browser_check",
