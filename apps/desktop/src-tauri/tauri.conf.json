{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Creator Agent",
  "version": "0.1.0",
  "identifier": "com.creatoragent.studio",
  "build": {
    "frontendDist": "../control"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost",
      "capabilities": [
        {
          "identifier": "control-window",
          "description": "Bundled setup/status window only; the remote studio UI has no native IPC.",
          "local": true,
          "windows": ["control"],
          "permissions": [
            "allow-studio-state",
            "allow-studio-detect-postgres",
            "allow-studio-inspect-source",
            "allow-studio-setup",
            "allow-studio-retry",
            "allow-studio-migrate",
            "allow-studio-preferences",
            "allow-studio-source-hosts",
            "allow-studio-sign-in",
            "allow-studio-sign-out",
            "allow-studio-open-logs",
            "allow-studio-open",
            "allow-studio-quit",
            "allow-studio-update-settings",
            "allow-studio-update-forget-token",
            "allow-studio-update-check",
            "allow-studio-update-download",
            "allow-studio-update-install"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
